if SHIELD_LEIGHBOARD26_DONGLE

# Name must be less than 16 characters long!
config ZMK_KEYBOARD_NAME
    default "leighboard26"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
  default 2

config BT_MAX_CONN
  default 6

config BT_MAX_PAIRED
  default 6

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
  default n

endif

if SHIELD_LEIGHBOARD26_LEFT

# Name must be less than 16 characters long!
config ZMK_KEYBOARD_NAME
    default "leighboard26"

config ZMK_SPLIT_ROLE_CENTRAL
    default n

config ZMK_SPLIT
    default y
    
endif

if SHIELD_LEIGHBOARD26_LEFT || SHIELD_LEIGHBOARD26_RIGHT

config ZMK_SPLIT_ROLE_CENTRAL
    default n

config ZMK_SPLIT
    default y

endif


